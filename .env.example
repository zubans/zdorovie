# ==============================================================================
# Environment Configuration
# ==============================================================================

# Application Environment (local, staging, production)
APP_ENV=local
APP_DEBUG=true
PUBLIC_BASE_URL=http://localhost

# Reverse Proxy & Ports
NGINX_PORT=80
BACKEND_HOST_PORT=8080
BACKEND_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=zdorovie_db
POSTGRES_USER=zdorovie_user
POSTGRES_PASSWORD=zdorovie_secret

# Redis Cache & Asynq Queues
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=

# MinIO S3 Object Storage
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost/s3
MINIO_USE_SSL=false
MINIO_BUCKET_MASTER=zdorovie-master
MINIO_BUCKET_CLIENT=zdorovie-client-materials
MINIO_BUCKET_CONSULTATIONS=zdorovie-consultations

# MAX Messenger Bot API (MAX_MODE: mock | live)
MAX_MODE=mock
MAX_API_URL=https://platform-api.max.ru
MAX_BOT_TOKEN=test_max_bot_token
MAX_WEBHOOK_SECRET=test_max_webhook_secret_key_1234567890

# YooKassa Payment Gateway (YOO_MODE: mock | live)
YOO_MODE=mock
YOO_VERIFY_IP=false
YOO_SHOP_ID=test_shop_id
YOO_SECRET_KEY=test_secret_key
YOO_RETURN_URL=http://localhost/cabinet/payment-success

# JWT Authentication, Magic Links & Admin Bootstrap
JWT_SECRET=default_secret_key_must_be_at_least_32_characters_long_for_security
MAGIC_LINK_BASE_URL=http://localhost/cabinet/auth/magic
MAGIC_LINK_TTL_MINUTES=30
ADMIN_EMAIL=doctor@zdorovie.local
ADMIN_PASSWORD=zdorovie_doctor_pass
DOCTOR_API_TOKEN=zdorovie_doctor_agent_token_123456

# Email Notifications (EMAIL_MODE: mock | smtp)
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zdorovie.local

# ML Worker (STT_PROVIDER: mock | faster_whisper; LLM_PROVIDER: mock | yandexgpt | gigachat)
STT_PROVIDER=mock
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8
LLM_PROVIDER=mock
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
GIGACHAT_AUTH_KEY=
